# Copy to /Users/.../ombud/.env (gitignored). Never commit real values.
DATABASE_URL=postgres://localhost:5432/overpaid

# AWS (Bedrock + AgentCore Browser), region with Global Claude inference profiles
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
BEDROCK_EXTRACT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
AGENTCORE_BROWSER_ID=
# Fallback model access if Bedrock is blocked
ANTHROPIC_API_KEY=
# Fleet session provider: agentcore | local
FLEET_PROVIDER=local
# Fleet optional knobs (defaults shown): model client auto|bedrock|anthropic|none (none forces scripted mode)
# FLEET_MODEL_CLIENT=auto
# ANTHROPIC_MODEL=claude-sonnet-5-5
# FLEET_MAX_SESSIONS=8
# AGENTCORE_SESSION_TIMEOUT_SECONDS=900
# AGENTCORE_LIVEVIEW_EXPIRES_SECONDS=300
# AgentCore browsers cannot reach localhost: point each merchant at its public tunnel hostname
# MERCHANT_BASE_VISTAFLIX=https://vistaflix.example.org

# Cardano preprod
CARDANO_NETWORK=preprod
BLOCKFROST_PROJECT_ID=
X402_FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
USDM_ASSET=
# Seeds live in .env.wallets (gitignored), generated by scripts/gen-wallets.ts

# Public hostname (named tunnel) for the specialist, providers and /join
PUBLIC_BASE_URL=
SPECIALIST_PUBLIC_URL=

# services/bloc (Bargain act) and services/providers
BLOC_N_MAX=40
BLOC_ADMIN_TOKEN=
BLOC_JOIN_PER_IP=3
BLOC_SIM_BATCH=60
BLOC_SIM_INTERVAL_MS=30000
PROVIDERS_URL=http://127.0.0.1:4400
BLOC_URL=http://127.0.0.1:4300
PROVIDERS_INTERVAL_MS=20000
